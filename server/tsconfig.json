{
    "compilerOptions": {
        "target": "ES2021",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "outDir": "dist",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": [
        "src/**/*",
        "../src/shared/**/*",
        "../src/types/**/*",
        "../src/utils/**/*"
    ],
    "exclude": [
        "node_modules",
        "../src/**/*.test.ts",
        "../src/**/*.test.tsx",
        "../src/test/**/*"
    ]
}